# =====================================================================
# SmartSpender — environment variables (copy to .env and edit)
# =====================================================================

# ---------- Database ----------
POSTGRES_DB=smartspender
POSTGRES_USER=smartspender
POSTGRES_PASSWORD=smartspender

# ---------- Backend ----------
# MUST be at least 32 characters for HS256
APP_JWT_SECRET=dev-only-change-me-super-secret-key-that-is-long-enough-for-hs256
APP_FRONTEND_BASE_URL=http://localhost

# ---------- Email (dev) ----------
# Set to true and configure SMTP_* for production sending.
APP_MAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=